# Dockerfile cho Backend Production (FastAPI + OCR Pipeline)
FROM python:3.12-slim

WORKDIR /app

# Cài đặt các thư viện hệ thống cần thiết cho OpenCV, PyMuPDF và PostgreSQL
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Cài đặt dependencies Python: Cài đặt PyTorch CUDA 12.8 (tương thích RTX 5070 / sm_120 và kiến trúc GPU hiện đại)
COPY requirements.txt .
RUN pip install --no-cache-dir -U pip wheel && \
    pip install --no-cache-dir "setuptools<70" && \
    pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cu128 && \
    pip install --no-cache-dir -r requirements.txt

# Copy toàn bộ mã nguồn backend và cấu hình vào image
COPY backend /app/backend
COPY backend/configs /app/configs
COPY run.py /app/run.py

# Khai báo biến môi trường cho module import
ENV PYTHONPATH=/app/backend/src:/app/backend:/app \
    PYTHONUNBUFFERED=1

EXPOSE 8000

# Khởi chạy server FastAPI đầy đủ tính năng
CMD ["uvicorn", "backend.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
