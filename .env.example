# Sao chép file này thành .env và đặt giá trị phù hợp với môi trường của bạn.
# Không commit .env thật vì nó có thể chứa mật khẩu và đường dẫn nội bộ.

# PostgreSQL dùng khi chạy ứng dụng cục bộ hoặc Docker.
PG_HOST=127.0.0.1
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=replace-with-a-strong-password
PG_DATABASE=ocr_so_do

# Hệ thống yêu cầu PostgreSQL để lưu trữ và quản lý kho dữ liệu OCR.
OCR_POSTGRES_ENABLED=true
# Khoảng thời gian thử kết nối lại PostgreSQL khi dịch vụ vừa được khởi động.
OCR_POSTGRES_RETRY_SECONDS=60

# Chỉ những web origin này được gọi API từ trình duyệt.
OCR_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8088,http://localhost:8088

# Giới hạn an toàn của một file upload; giá trị hợp lệ là 1-500 MB.
OCR_MAX_UPLOAD_MB=200

# Docker chỉ bind vào localhost theo mặc định. Đặt 0.0.0.0 chỉ khi có reverse proxy/TLS/auth.
OCR_BIND_HOST=127.0.0.1

# Giới hạn worker batch để kiểm soát bộ nhớ.
OCR_BATCH_WORKER_MAX_FILES=10
OCR_BATCH_FILE_TIMEOUT_SECONDS=900

# Keycloak là nguồn tài khoản nội bộ. Chỉ đặt OCR_AUTH_ENABLED=false khi phát
# triển cục bộ, tuyệt đối không dùng trong môi trường có dữ liệu thật.
OCR_AUTH_ENABLED=true
OCR_KEYCLOAK_PUBLIC_URL=http://127.0.0.1:8081
OCR_KEYCLOAK_REALM=ocr-so-do
OCR_KEYCLOAK_CLIENT_ID=ocr-so-do-web
OCR_KEYCLOAK_ADMIN_CLIENT_ID=ocr-so-do-admin-api
OCR_KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-a-long-random-service-secret

# Keycloak bootstrap admin (quản trị máy chủ SSO, khác OCR app admin).
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=kc-bootstrap-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-strong-keycloak-db-password
KEYCLOAK_DB_DATABASE=keycloak

# Tài khoản OCR đầu tiên, có role ocr-admin. Bắt buộc đổi mật khẩu ở lần login đầu.
OCR_INITIAL_ADMIN_USERNAME=admin
OCR_INITIAL_ADMIN_PASSWORD=admin

# Chỉ cho phép batch quét các thư mục này (dấu phẩy để tách nhiều thư mục).
# Ví dụ Windows: D:\OCR\NguonHoSo,D:\OCR\NguonDuLieuKhac
# VILG HSQ: đặt thư mục gốc xã/phường (hoặc nhiều thư mục, cách nhau bằng dấu phẩy).
OCR_ALLOWED_SOURCE_ROOTS=
# Docker bind-mount thư mục này read-only thành /data/hsq-vilg cho backend.
OCR_HSQ_VILG_SOURCE_PATH=
# Dạng host_path=>container_path, ví dụ D:\OCR\HSQ=>/data/hsq-vilg.
OCR_SOURCE_PATH_ALIASES=

# Swagger chỉ mở có chủ đích khi phát triển cục bộ.
OCR_EXPOSE_API_DOCS=false
